#!/bin/bash

set -euo pipefail

# Default image
IMAGE="ghcr.io/evancarroll/coding-agent-podman/codex:latest"
PULL=newer
NAME="codex-$(uuidgen -r | cut -d- -f1)"
INIT_SCRIPT=""
APK_PACKAGES=""
PODMAN_ARGS=()

# By default codex keeps its own sandbox inside the container: writes are
# confined to the workspace, the network is off, and anything else asks for
# approval, the same as claude-podman without --yolo. These are codex's own
# defaults, spelled out because any -c keeps codex off its background server,
# which can't start under podman. --yolo drops the sandbox and the prompts.
# The inner quotes are literal: codex parses -c key=value as TOML.
CODEX_ARGS=(-c 'sandbox_mode="workspace-write"' -c 'approval_policy="on-request"')

die() {
	printf '%s: %s\n' "${0##*/}" "$*" >&2
	exit 1
}

need_arg() {
	[ "$2" -ge 2 ] || die "$1 requires a value"
}

# Process arguments
while [[ $# -gt 0 ]]; do
	case "$1" in
	--help)
		cat <<-'EOT'
			Usage: codex-podman [OPTIONS] [CODEX ARGS...]

			Run OpenAI Codex in a rootless Podman container

			Options:
			  --local              Use local image 'codex:latest' instead of remote
			  --yolo               No sandbox inside the container and no approval
			                       prompts: the container is the only boundary
			  --login              Make 'codex login' work: publish port 1455 and route
			                       it to the container's loopback, where codex listens
			                       (needs pasta; no-port alternative: login --device-auth)
			  --init-script FILE   Execute initialization script as root in the container
			  --apk-packages LIST  Install additional Alpine packages (comma or space separated)
			  --podman-arg ARG     Pass one additional argument to podman run (repeatable)
			  --self-update        Replace this launcher with the latest from GitHub
			  --help               Display this help message

			The first unrecognized argument and everything after it is passed
			through to codex itself, so launcher options must come first.
		EOT
		exit 0
		;;
	--self-update)
		curl --proto '=https' --tlsv1.2 -sSf \
			https://raw.githubusercontent.com/EvanCarroll/coding-agent-podman/refs/heads/main/bin/codex |
			sudo tee /usr/local/bin/codex-podman >/dev/null
		sudo chmod a+x /usr/local/bin/codex-podman
		echo "Updated"
		exit 0
		;;
	--local)
		IMAGE="codex:latest"
		PULL=never
		shift
		;;
	--yolo)
		CODEX_ARGS=(-c 'sandbox_mode="danger-full-access"' -c 'approval_policy="never"')
		shift
		;;
	--login)
		# codex binds its OAuth callback server to 127.0.0.1 inside the
		# container. Publishing the port is not enough: pasta delivers inbound
		# connections to the container's public address, which that listener
		# never sees, so the browser gets a connection reset. --host-lo-to-ns-lo
		# makes traffic published from the host's loopback arrive on the
		# container's loopback instead. If pasta is unavailable, skip --login
		# and run 'codex-podman login --device-auth', which needs no port.
		PODMAN_ARGS+=(--network=pasta:--host-lo-to-ns-lo -p 127.0.0.1:1455:1455)
		shift
		;;
	--init-script)
		need_arg "$1" $#
		[ -f "$2" ] || die "--init-script: no such file: $2"
		INIT_SCRIPT="$2"
		shift 2
		;;
	--apk-packages)
		need_arg "$1" $#
		APK_PACKAGES="$2"
		shift 2
		;;
	--podman-arg)
		need_arg "$1" $#
		PODMAN_ARGS+=("$2")
		shift 2
		;;
	*)
		break
		;;
	esac
done

command -v podman >/dev/null || die "podman is not installed"

# Podman would create this as a root-owned directory if it doesn't exist yet.
mkdir -p "${HOME}/.codex"

# ~/.codex is writable, but these parts of it are what the host's own codex
# runs code from (notify, MCP servers, hook trust, execpolicy rules) or takes
# orders from. Left writable, the agent could plant something that runs outside
# the container the next time you use codex on the host, so they are mounted
# read-only over the top. Missing ones are created first, or the agent could
# simply create them. Project trust and settings are changed on the host.
touch "${HOME}/.codex/config.toml" "${HOME}/.codex/AGENTS.md"
mkdir -p "${HOME}/.codex/rules"
for p in config.toml AGENTS.md rules; do
	PODMAN_ARGS+=(-v "${HOME}/.codex/$p:/home/codex/.codex/$p:ro")
done

# codex won't start in a folder it hasn't been told to trust, and it can't
# save that answer to the read-only config.toml, so running codex-podman here
# counts as the answer. It's recorded on the host just as codex would.
TRUST_KEY=${PWD//\\/\\\\}
TRUST_KEY="[projects.\"${TRUST_KEY//\"/\\\"}\"]"
if ! grep -qF "$TRUST_KEY" "${HOME}/.codex/config.toml"; then
	printf '\n%s\ntrust_level = "trusted"\n' "$TRUST_KEY" >>"${HOME}/.codex/config.toml"
	printf '%s: trusting %s in ~/.codex/config.toml\n' "${0##*/}" "$PWD" >&2
fi

# The host's git identity and aliases, read-only so the agent can't rewrite
# them. Credential helpers it names won't exist in the container, which is
# the point: the agent gets no git credentials.
[ -f "${HOME}/.gitconfig" ] &&
	PODMAN_ARGS+=(-v "${HOME}/.gitconfig:/home/codex/.gitconfig:ro")
GIT_XDG_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/git/config"
[ -f "$GIT_XDG_CONFIG" ] &&
	PODMAN_ARGS+=(-v "${GIT_XDG_CONFIG}:/home/codex/.config/git/config:ro")

cleanup() {
	podman rm -f -t 0 "$NAME" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# The container idles until setup is done, then codex is exec'd into it, so
# it never starts before its packages are installed. --init reaps whatever
# codex's subprocesses leave behind. label=disable keeps SELinux hosts from
# denying the bind mounts without relabeling your files; elsewhere it's a no-op.
podman run \
	-v "${HOME}/.codex:/home/codex/.codex" \
	-v "${PWD}:${PWD}" \
	-w "$PWD" \
	--rm \
	--detach \
	--init \
	--pull="$PULL" \
	--tz=local \
	--security-opt label=disable \
	--name "$NAME" \
	--user codex \
	--userns=keep-id:uid=1000,gid=1000 \
	--entrypoint sleep \
	"${PODMAN_ARGS[@]}" \
	"$IMAGE" infinity >/dev/null

# Mounting the XDG git config makes podman create ~/.config as root; give it
# back so codex and its tools can still write there.
podman exec --user root:root "$NAME" chown codex:codex /home/codex/.config 2>/dev/null || true

if [ -n "$APK_PACKAGES" ]; then
	read -ra PACKAGES <<<"${APK_PACKAGES//,/ }"
	podman exec --user root:root "$NAME" apk add --no-cache "${PACKAGES[@]}"
fi
if [ -n "$INIT_SCRIPT" ]; then
	podman cp "$INIT_SCRIPT" "$NAME:/root/init.sh"
	podman exec --user root:root "$NAME" zsh /root/init.sh
fi

# -t only with a terminal on both ends, so codex exec works in a pipe. Empty
# --detach-keys stops podman from swallowing Ctrl-P.
#
# It runs in the background so a hangup (terminal or ssh session closed) fires
# the cleanup trap at once; bash holds traps until a foreground child exits,
# and podman exec doesn't always get the SIGHUP itself. Without job control a
# background job's stdin is /dev/null, so the terminal is passed on fd 3.
TTY=()
[ -t 0 ] && [ -t 1 ] && TTY=(-t)
exec 3<&0
podman exec -i "${TTY[@]}" \
	--detach-keys= \
	--user codex \
	-w "$PWD" \
	-e TERM -e COLORTERM -e LANG \
	"$NAME" codex "${CODEX_ARGS[@]}" "$@" <&3 3<&- &
rc=0
wait $! || rc=$?
exit "$rc"
